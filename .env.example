# Cookies de sesión Noctools
COOKIE_SESSIONID=
COOKIE_CSRFTOKEN=
COOKIE_CF_AUTHORIZATION=
COOKIE_CF_APP_SESSION=
COOKIE_JWT_SESSION=
COOKIE_CF_BM=

# ─── Bot Tokens de Slack ───
# Los tokens se nombran dinámicamente: SLACK_BOT_TOKEN_{NOMBRE}
# donde {NOMBRE} es el valor de la columna "organizacion" o "workspace" del CSV (en mayúsculas).
# El nombre debe ser alfanumérico, sin espacios ni caracteres especiales.

# Token de organización (compartido por todos los workspaces dentro de la org)
# Ejemplo: si en el CSV la organización es "MIORG", la variable es SLACK_BOT_TOKEN_MIORG
# SLACK_BOT_TOKEN_MIORG=

# Token de workspace standalone (workspace fuera de una organización)
# Ejemplo: si en el CSV el workspace es "MIWS" y la organización está vacía
# SLACK_BOT_TOKEN_MIWS=

# ─── Defaults de workspace y organización ───
# Se usan como fallback si el CSV no trae workspace u organización.
# Debe estar configurado al menos uno de los dos.
# DEFAULT_WORKSPACE=MYDEFAULT
# DEFAULT_ORGANIZATION=

# ─── Subdominios de Slack para permalinks en Telegram ───
# Se nombran dinámicamente: SLACK_SUBDOMAIN_{WORKSPACE}
# donde {WORKSPACE} es el valor de la columna "workspace" del CSV (en mayúsculas).
# El subdominio es la parte que va antes de .slack.com en la URL del workspace.
# Ejemplo: SLACK_SUBDOMAIN_MIWS=mi-subdominio → https://mi-subdominio.slack.com/...
# Si no está configurado, el mensaje de Telegram se envía sin el link de Slack.
# SLACK_SUBDOMAIN_MIWS=

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=

# ─── URLs internas (OBLIGATORIAS — sin defaults en el código) ───
# Completar con las URLs correspondientes. Sin estas variables el script no inicia.
URL_ALERTS_NO_ACK=
URL_ALERTS_ACK=
URL_NAGIOS_DASHBOARD=
URL_NOC_DUTY=
URL_NOC_DUTY_INCIDENTES=
URL_JIRA_BROWSE=

# ─── Parámetros opcionales (valores por defecto incluidos en el código) ───

# URL de Slack API (opcional)
# SLACK_API=https://slack.com/api/chat.postMessage

# Headers HTTP (opcional)
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36
# ACCEPT_LANGUAGE=es-419,es;q=0.9,en;q=0.8

# Parámetros de tickets Jira (opcional)
# TICKETS_FILTER=RA_FA_A_TA_O_I
# TICKETS_LOOKBACK_DAYS=2

# Patrones de extracción de links de NewRelic (opcional)
# Si la plataforma de monitoreo usa otra estructura de URLs, se pueden override aquí.
# Defaults incluidos en el código buscan patrones nr1-core/apm/overview, errors-inbox y alerts/filtered-feed.
# NR_APP_LINK_PATTERN=
# NR_ERRORS_LINK_PATTERN=
# NR_ISSUES_LINK_PATTERN=

# Parámetros de Selenium (opcional)
# SELENIUM_TIMEOUT=180
# SELENIUM_POST_LOGIN_SLEEP=3

# Timeouts HTTP en segundos (opcional)
# REQUESTS_TIMEOUT=15
# SLACK_TIMEOUT=10
# TELEGRAM_TIMEOUT=10

# ─── Parámetros de Telegram (opcionales — valores por defecto incluidos) ───

# URL de la API de Telegram (opcional)
# TELEGRAM_API=https://api.telegram.org

# Horario de envío de Telegram (opcional)
# TELEGRAM_START_HOUR=18
# TELEGRAM_END_HOUR=0

# Zona horaria para el chequeo de horario (opcional)
# TELEGRAM_TIMEZONE=UTC